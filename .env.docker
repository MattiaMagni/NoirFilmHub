# ============================================
# NoirFilmHub — Environment for Docker Compose
# ============================================
# Copy this file to .env.docker and fill in the values.
# WARNING: Never commit real secrets to version control.

# Database
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=film-api-db
DB_USER=root
DB_PASSWORD=root
DB_PROVIDER=MySql
DB_SERVER_VERSION=10.11.0-mariadb
DB_USE_AUTODETECT=false

# ASP.NET
ASPNETCORE_ENVIRONMENT=Development

# JWT
JWT_SECRET_KEY=dev-jwt-secret-key-for-docker-compose-minimum-64-characters-long!!
JWT_ISSUER=FilmAPI
JWT_AUDIENCE=FilmFrontend
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

# App
APP_BASE_URL=http://localhost:5001

# Stripe (test mode)
STRIPE_SECRET_KEY=sk_test_change_me
STRIPE_WEBHOOK_SECRET=whsec_change_me

# TMDB
TMDB_API_READ_TOKEN=change_me
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_LANGUAGE=it-IT
TMDB_FALLBACK_LANGUAGE=en-US
TMDB_REGION=IT
TMDB_SYNC_ENABLED=true
TMDB_SYNC_HOUR=03

# SMTP (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=change_me@gmail.com
SMTP_PASSWORD=change_me
SMTP_FROM=noreply@noirfilmhub.local
SMTP_FROM_NAME=Noir Film Hub

# OAuth — Google
GOOGLE_CLIENT_ID=change_me
GOOGLE_CLIENT_SECRET=change_me

# OAuth — Microsoft
MICROSOFT_CLIENT_ID=change_me
MICROSOFT_CLIENT_SECRET=change_me

# Admin seed
DEFAULT_ADMIN_EMAIL=admin@noirfilmhub.local
DEFAULT_ADMIN_PASSWORD=Admin123!

# Feature flags
AUTH_ENABLED=true
RUN_SEEDER=false
RESET_USERS=false
RESEED_PROIEZIONI=false
FEATURE_SOCIAL_LOGIN=true
FEATURE_SOCIAL_GOOGLE_ENABLED=true
FEATURE_SOCIAL_MICROSOFT_ENABLED=true
FEATURE_AUDIT_LOGGING=true
FEATURE_RATE_LIMITING=true
FEATURE_IP_TRACKING=false

# Rate limiting
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REGISTER_PER_15MIN=3
RATE_LIMIT_FORGOT_PASSWORD_PER_15MIN=3

# Account token TTL
ACCOUNT_TOKEN_PASSWORD_RESET_TTL_MINUTES=60
ACCOUNT_TOKEN_PASSWORD_SETUP_TTL_MINUTES=1440
ACCOUNT_TOKEN_ADMIN_INVITE_TTL_HOURS=72
